skilltemplate("子弹技")
{:
  section(1000)
  {
    animation(Attack);
    //adjust_section_duration("anim",100);
    self_effect(selfEffect,1000,hit,0);
    emit_effect(emitEffect,hit,0,15);
  };
  emitskill
  {
    section(10000)
    {
    	track(hit,false,0);
    };
  };
  hitskill
  { 
  	section(1000)
  	{
	    animation(Hit);
	    self_effect(hitEffect, 1000, hit, 0);
	    damage(0);   
	    lock_frame(0,0,166);
	  };
  };  
:};
