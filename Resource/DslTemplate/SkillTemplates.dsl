skilltemplate("控制buff")
{:
  section(10)
  {
    enable_move_agent(false);
    add_impact_to_self(0,10002);
    store_pos();
  };
  section(300)
  {
    animation(Fukong);
    adjust_section_duration('anim',200);
  };
  onstop
  {
    restore_pos();
    enable_move_agent(true);
    stop_impact(0,10002);
  };
:};