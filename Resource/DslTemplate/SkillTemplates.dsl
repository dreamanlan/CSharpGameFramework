skilltemplate("普通攻击")
{:
  section(1000)
  {
    animation(Attack);
    //adjust_section_duration("anim",100);
    self_effect(selfEffect,1000,"hit",0);
    impact(0,0,0,0,false);
  };  
  hitskill
  { 
  	section(1000)
  	{
	    animation(Hit);
	    self_effect(hitEffect, 1000, hit, 0);
	    damage(0);   
	    lock_frame(0,0,166);
	  };
  };  
:};
