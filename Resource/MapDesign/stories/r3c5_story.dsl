story(battle_main)
{
  // Stage 1: entry encounter at the portal. Multi-area progression driven by
  // MapData/{tid}_areas*.txt is a stage-2 feature (player movement + events).
  onmessage("start")
  {
    createnpc(1000,vector3(60,15.6,70),0,3,1,"ai_player",stringlist("Ai/ailogic_player.dsl"));
    setleaderid(unitid2objid(1000));
    npcsetformation(1000,0);
    loop(4){
      createnpc(1001+$$,vector3(60+rndint(0,10),15.6,70+rndint(0,10)),0,3,$$+2,"ai_member",stringlist("Ai/ailogic_member.dsl"),getleaderid());
      npcsetformation(1001+$$,$$+1);
    };
    camerafollow(1000);
    publishgfxevent("loading_complete", "ui");
    startstory("auto_battle");
    loop(12){
      createnpc(1006+$$,vector3(45+rndint(0,30),15.6,55+rndint(0,30)),0,4,$$+6,"ai_normal",stringlist("Ai/ailogic_normal.dsl"));
    };
  };
  onmessage("all_killed")
  {
    clearmessage("show_dlg");
    firemessage("show_dlg",998);
  };
  onmessage("npc_killed:1000")
  {
    clearmessage("show_dlg");
    firemessage("show_dlg",999);
  };
  onmessage("all_died")
  {
    clearmessage("show_dlg");
    firemessage("show_dlg",999);
  };
  onmessage("dialog_over",998)
  {
    terminate();
    closebattle(10030);
  };
  onmessage("dialog_over",999)
  {
    terminate();
    closebattle(10030);
  };
};
