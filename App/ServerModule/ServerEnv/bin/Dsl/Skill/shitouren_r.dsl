skill(102)
{
  section(10)
  {
    hit_effect(hitEffect, "eyes", 0, 1000, "Stand", 100);
    face_to_target(0,10,0,"maxdist");
  };
  section(1000)
  {
    enable_move_agent(false);
    animation("Walk");
    self_effect(selfEffect,1000,"eyes",0)
    {
      transform(vector3(0,1,0));
    };
    target_effect(hitEffect,1000,"eyes",0)
    {
      transform(vector3(0,1,0));
    };
    charge(200,10,1,vector3(0,0,-0.5),0){
    	keyframe(0,0,2,2);
    	keyframe(1,1,2,2);
    };
    aoe_impact(-3,0,0,-1,true);
  };
  onstop
  {
    enable_move_agent(true);
  };
};